{
  "name": "@nectar-js/i18n",
  "version": "0.1.0",
  "description": "Translations for Nectar bots: message catalogs, localized command metadata, and typed keys.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nectar-js/nectar": "workspace:^",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@nectar-js/nectar": "workspace:*",
    "discord.js": "^14.27.0"
  },
  "dependencies": {
    "discord-api-types": "^0.38.55"
  }
}
